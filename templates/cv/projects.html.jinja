<section id="projects">
  <h2 class="h1">Projects</h2>

  <ul>
    {%- for project in projects -%}
    {%- set display_name = project.name or project.type -%}
    {%- set link -%}
    {%- if project.url -%}
      <a class="h2 cv__project-link"
         href="{{- project.url -}}">{{- display_name -}}</a>
    {%- else -%}
      {{- display_name -}}
    {%- endif -%}
    {%- endset -%}

    <li class="cv__list-item">
      <h3 class="h2 cv__subheading">
        {%- if project.is_media -%}
          <cite class="h2">{{- link | trim -}}</cite>
        {%- else -%}
          {{- link | trim -}}
        {%- endif -%}

        {%- if project.name -%}
          &nbsp;{{- project.type -}}
        {%- endif -%}
      </h3>

      <ul>
        <li class="cv__list-item">
          <dl class="cv__sub-subheading">
            <dt><h4 class="cv__exp-role">{{- project.roles -}}</h4></dt>
            <dd class="cv__date-container"><h5><span
              class="cv__exp-date">{{- project.start_date | date -}}</span>–<span
              class="cv__exp-date">
            {%- if project.end_date -%}
              {{- project.end_date | date -}}
            {%- else -%}
              Present
            {%- endif -%}</span></h5>
            </dd>
          </dl>

          {%- if project.highlights -%}
            <ul>
              {%- for highlight in project.highlights -%}
                <li class="cv__list-item"><p class="copy-text">
                  {{- highlight -}}
                </p></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

        </li>
      </ul>
    </li>
    {%- endfor -%}
  </ul>
</section>
