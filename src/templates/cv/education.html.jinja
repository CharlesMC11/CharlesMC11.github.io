<section id="education">
  <h2 class="h1">Education</h2>

  <ul class="cv__list-container">
    {%- for institution in education -%}
      <li class="cv__list-item">
        <h3 class="h2 cv__subheading">
          {{- institution.institution | trim -}}
        </h3>

        <ul>
          {%- for concentration in institution.concentrations -%}
            <li class="cv__list-item">

              <dl class="cv__sub-subheading">
                <dt><h4>
                  {{- concentration.degree | trim -}}&nbsp;{{- concentration.name | trim -}}
                  {%- if concentration.honors -%},
                    {{ concentration.honors | trim -}}
                  {%- endif -%}
                </h4></dt>

                <dd class="cv__date-container">
                  <h5>{{- concentration.award_date | date_fmt -}}</h5>
                </dd>
              </dl>

            </li>
          {%- endfor -%}

          {%- if institution.certificates -%}
            <li class="cv__list-item">Certificates of Achievement
              <ul>
                {%- for cert in institution.certificates -%}
                  <li
                    class="cv__list-item">{{- cert.concentration | trim -}}</li>
                {%- endfor -%}
              </ul>
            </li>
          {%- endif -%}
        </ul>

      </li>
    {%- endfor -%}

  </ul>
</section>