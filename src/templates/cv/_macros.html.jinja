{%- macro project_link(type, name=None, url=None) -%}
  {%- set display_name = name or type -%}
  {%- if url -%}
    <a class="h2 cv__project-link" href="{{- url | trim -}}">{{- display_name | trim -}}</a>
  {%- else -%}
    {{- display_name | trim -}}
  {%- endif -%}
{%- endmacro -%}

{% macro timed_entry(name, start_date, end_date=None, highlights=None) %}
  <li class="cv__list-item">
    <div class="cv__sub-subheading">
      <h4 class="cv__entry_name">{{ name | trim }}</h4>

      {% set formatted_start_date = start_date | date_fmt %}
      {% set formatted_end_date = end_date | date_fmt %}

      <time class="cv__date-container">{{- formatted_start_date -}}
        {%- if formatted_start_date != formatted_end_date -%}
          –{{- formatted_end_date -}}
        {%- endif -%}</time>
    </div>

    {% if highlights %}
      <ul>
        {% for highlight in highlights %}
          <li class="cv__list-item"><p class="copy-text">{{ highlight | trim }}</p></li>
        {% endfor %}
      </ul>
    {% endif %}
  </li>
{% endmacro %}

{%- macro format_honors(honors) -%}
  {%- if "cum laude" in honors -%}
    <i lang="la">{{- honors | trim -}}</i>
  {%- else -%}
    {{- honors | trim -}}
  {%- endif -%}
{%- endmacro -%}
