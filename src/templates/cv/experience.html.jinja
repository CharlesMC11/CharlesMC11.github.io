<section id="experience">
  <h2 class="h1">Experience</h2>

  <ul>
    {%- for company in experience -%}
      <li class="cv__list-item">
        <h3 class="h2 cv__subheading">{{- company.company | trim -}}</h3>

        <ul>
          {%- for role in company.roles -%}
            <li class="cv__list-item">
              <dl class="cv__sub-subheading">

                {# TODO: Perhaps extract this into its own `.jinja` template? #}
                <dt><h4>{{- role.name | trim -}}</h4></dt>
                <dd class="cv__date-container">
                  <h5>{{- role.start_date | date_fmt -}}–
                    {%- if role.end_date -%}
                      {{- role.end_date | date_fmt -}}
                    {%- else -%}
                      Present
                    {%- endif -%}</h5>
                </dd>
              </dl>

              {%- if role.highlights -%}
                <ul>
                  {%- for highlight in role.highlights -%}
                    <li class="cv__list-item"><p class="copy-text">
                      {{- highlight | trim -}}
                    </p></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

            </li>
          {%- endfor -%}
        </ul>

      </li>
    {%- endfor -%}

  </ul>
</section>